# Build context: the e2e/ directory
#
# Layers the e2e runtime configuration on top of the *production* image built from
# apps/private/Dockerfile, so the artifact under test is the one we actually ship.
ARG FRONTEND_IMAGE="twake-calendar-web-e2e-base"

FROM ${FRONTEND_IMAGE}

COPY src/test/resources/frontend/env.js /usr/share/nginx/html/.env.js
# named .e2e.js because the repository ignores every appList.js, so a file under
# that name would live on the machine that made it and nowhere else
COPY src/test/resources/frontend/appList.e2e.js /usr/share/nginx/html/appList.js
