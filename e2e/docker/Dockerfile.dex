# Build context: the e2e/ directory
#
# openid-client, used by the SPA, refuses to talk OIDC over plain http. Dex therefore serves
# https on 5554 -- with a throwaway self signed certificate the browser is told to ignore --
# next to the plain http listener on 5556 the side service uses from inside the network.
FROM alpine:3.20 AS certs
RUN apk add --no-cache openssl \
 && openssl req -x509 -newkey rsa:2048 -nodes -days 3650 \
      -subj "/CN=sso" -addext "subjectAltName=DNS:sso,DNS:localhost,IP:127.0.0.1" \
      -keyout /tls.key -out /tls.crt \
 && chmod 644 /tls.key /tls.crt

# Digest pinned so that the OIDC provider never drifts under the test suite.
FROM ghcr.io/dexidp/dex@sha256:edd1d651b502a6afd0cc18cffb3733b8ab7910718d83dbb44906f10f84970282

COPY --from=certs /tls.crt /etc/dex/tls.crt
COPY --from=certs /tls.key /etc/dex/tls.key
COPY src/test/resources/oidc/dex_config.yaml /etc/dex/config.yaml
