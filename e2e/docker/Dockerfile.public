# Build context: the e2e/ directory
#
# Same idea as Dockerfile.frontend, for the public SPA: layers the e2e runtime configuration
# on top of the production image built from apps/public/Dockerfile.
ARG PUBLIC_IMAGE="twake-calendar-web-public-e2e-base"

FROM ${PUBLIC_IMAGE}

COPY src/test/resources/frontend/env.public.js /usr/share/nginx/html/.env.js
# index.html asks for it like the private app does; without it the page 404s on every load
# named .e2e.js because the repository ignores every appList.js, so a file under
# that name would live on the machine that made it and nowhere else
COPY src/test/resources/frontend/appList.e2e.js /usr/share/nginx/html/appList.js
